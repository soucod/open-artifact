{
  "name": "open-artifact-workspace",
  "private": true,
  "type": "module",
  "description": "Open, agent- and model-agnostic artifacts, all saved locally as plain files — edit, comment on, and export slides, UI designs, design systems, whiteboards, sheets, dashboards, docs, motion, and free HTML pages.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "plugins/dsh"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/*.test.ts\" \"plugins/dsh/test/*.test.ts\" \"plugins/zcode/test/*.test.mjs\" \"examples/host-plugins/*.test.mjs\" \"examples/harness-node/*.test.mjs\" \"examples/harness-stdio/*.test.mjs\" \"scripts/*.test.mjs\"",
    "check": "npm run typecheck && npm test",
    "e2e": "node e2e/run.mjs",
    "test:sea": "node --test e2e/sea/sea.test.mjs",
    "test-artifacts": "node test-artifacts/home.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
