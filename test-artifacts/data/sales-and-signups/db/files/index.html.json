{"text":"<meta name=\"dash-one-writer\">\n<link rel=\"stylesheet\" href=\"app.css\">\n<main class=\"fx\" data-read lang=\"en\">\n  <header class=\"fx-head\" id=\"overview\">\n    <h1 class=\"fx-title\" id=\"title\">Sales and signups</h1>\n    <p class=\"fx-lede\" data-read-step>Signups reached <b data-draw=\"latest\" data-source=\"signups\" data-field=\"signups\" data-where=\"month=2026-10\">—</b> in the latest month, <b data-draw=\"growth\" data-source=\"growth\">—</b> on the month before.</p>\n    <div class=\"fx-filters\">\n      <label>Region\n        <select class=\"dash-select\" data-draw=\"region\" aria-label=\"Region\" data-source=\"regions\"></select>\n      </label>\n      <button type=\"button\" class=\"fx-clear\" id=\"clear-filters\">Clear filters</button>\n    </div>\n  </header>\n\n  <nav class=\"fx-tabs\" role=\"tablist\">\n    <button type=\"button\" role=\"tab\" data-tab=\"revenue\" id=\"tab-revenue\">Revenue</button>\n    <button type=\"button\" role=\"tab\" data-tab=\"signups\" id=\"tab-signups\">Signups</button>\n    <button type=\"button\" role=\"tab\" data-tab=\"support\" id=\"tab-support\">Support</button>\n  </nav>\n\n  <section class=\"fx-page\" id=\"revenue\" data-tab-page=\"revenue\">\n    <div class=\"fx-cards\">\n      <article class=\"fx-card\" id=\"card-revenue\">\n        <h2>Revenue</h2>\n        <p class=\"fx-big\"><span data-draw=\"revenue-total\" data-source=\"revenue_total\" data-fetchpriority=\"high\">—</span></p>\n        <p class=\"fx-note\">All months shown, in dollars.</p>\n      </article>\n      <article class=\"fx-card\" id=\"card-target\">\n        <h2>Target</h2>\n        <p class=\"fx-big\"><span data-draw=\"target-total\" data-source=\"regions\" data-field=\"target\">—</span></p>\n        <p class=\"fx-note\">Sum of the region targets for FY27.</p>\n      </article>\n    </div>\n    <figure class=\"fx-chart\" id=\"revenue-chart\" data-source=\"orders\">\n      <figcaption>Revenue by month</figcaption>\n      <div class=\"fx-chart-body\" data-draw=\"revenue-chart\"></div>\n    </figure>\n    <table class=\"fx-table\" id=\"orders-table\" data-source=\"orders\" data-row-key=\"month\" data-fetchpriority=\"low\">\n      <thead><tr><th data-field=\"region\">Region</th><th data-field=\"month\">Month</th><th data-field=\"revenue\">Revenue</th><th data-field=\"orders\">Orders</th></tr></thead>\n      <tbody data-draw=\"orders-rows\"></tbody>\n    </table>\n  </section>\n\n  <section class=\"fx-page\" id=\"signups\" data-tab-page=\"signups\" hidden>\n    <figure class=\"fx-chart\" id=\"signups-chart\" data-source=\"signups\">\n      <figcaption>Signups per month</figcaption>\n      <div class=\"fx-chart-body\" data-draw=\"signups-chart\"></div>\n    </figure>\n    <p class=\"fx-note\" data-read-step>Click a bar to see that month. Picked: <b data-draw=\"picked\">—</b></p>\n  </section>\n\n  <section class=\"fx-page\" id=\"support\" data-tab-page=\"support\" hidden>\n    <h2>Open tickets</h2>\n    <ul class=\"fx-list\" data-source=\"tickets\" data-draw=\"tickets\"></ul>\n    <p class=\"fx-note\">Broken source: <b data-draw=\"broken\" data-source=\"broken\">—</b></p>\n  </section>\n</main>\n<script src=\"app.js\"></script>\n"}
