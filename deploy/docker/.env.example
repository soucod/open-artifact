# Settings for compose.yaml. Copy to .env (never commit .env) and fill in. Everything else has a safe default.
# packages/host/README.md explains each variable.

# ---- Addresses -----------------------------------------------------------------------------------------------------
# The app host: the home page, sign-in, the Shell. The session cookie lives only here.
APP_HOST=artifacts.example.com
# The content domain: every artifact's pages are served from <artifact-label>.CONTENT_DOMAIN. Use a different
# registrable domain from APP_HOST (example.net here vs example.com), so artifact pages can never reach the app's cookie.
# DNS: a wildcard record *.CONTENT_DOMAIN pointing at this server.
CONTENT_DOMAIN=oa-content.example.net
# Only one domain? CONTENT_DOMAIN may be APP_HOST's own domain (APP_HOST=app.example.com, CONTENT_DOMAIN=example.com)
# with OA_CONTENT_SAME_SITE=true. It is weaker: read "One domain for both" in docs/hosting.md before you turn it on.
# OA_CONTENT_SAME_SITE=false
# Let's Encrypt's contact address for the certificates (expiry warnings).
ACME_EMAIL=you@example.com

# ---- Secrets (generate, never commit) ------------------------------------------------------------------------------
# Signs page tokens and sign-in round trips, and encrypts share-link addresses. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#   (or: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
# To rotate: put the new key first and keep the old ones after it, comma-separated (the first signs, all verify).
OA_SIGNING_KEYS=
# The owner's sign-in secret (at least 24 characters, generated the same way). Leave empty and the host makes one on
# first start and prints the sign-in address once in `docker compose logs host`; `docker compose exec host node
# packages/host/src/node/main.ts owner-key` makes a new one later.
OA_OWNER_KEY=
# The name the owner starts with (they can sign in with other methods later).
OA_OWNER_NAME=

# ---- Sign-in and sign-up -------------------------------------------------------------------------------------------
# A JSON array of sign-in methods; empty = the owner key only. Example with Google (callback
# https://APP_HOST/auth/google/callback):
# OA_AUTH='[{"kind":"owner-key"},{"kind":"oidc","id":"google","name":"Google","issuer":"https://accounts.google.com","clientId":"…apps.googleusercontent.com","clientSecret":"…"}]'
OA_AUTH=
# Site admins, by email (comma-separated): they can open every artifact.
OA_OWNERS=
# Who may make an account by signing in: owners-only | invite (people something was shared with) | domain:<name> | open
OA_SIGNUP=invite
# The highest role a share link can give: editor | commenter | viewer
OA_LINK_MAX_ROLE=editor
# Whether an artifact may be made public (anyone with the address, as viewer).
OA_PUBLIC_ACCESS=true

# ---- Remote MCP (optional) -----------------------------------------------------------------------------------------
# Browser origins besides the app's that may call /mcp (comma-separated).
OA_MCP_ORIGINS=
# Pre-registered OAuth clients as JSON: [{"client_id":"…","client_name":"…","redirect_uris":["https://…"]}]
OA_OAUTH_CLIENTS=

# ---- TLS set-up ----------------------------------------------------------------------------------------------------
# Default: certificates on demand (Caddyfile.on-demand). For one wildcard certificate by DNS-01 (Caddyfile.dns),
# uncomment both lines below and set your DNS provider's token.
# COMPOSE_FILE=compose.yaml:compose.dns.yaml
# CLOUDFLARE_API_TOKEN=
# Another DNS provider's Caddy plugin (see Caddyfile.dns):
# CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare@v0.2.4

# ---- Images (optional) ---------------------------------------------------------------------------------------------
# A prebuilt host image to run instead of building this checkout, pinned to a version tag.
# OA_IMAGE=registry.example.com/open-artifact-host:0.12.3
# CADDY_IMAGE=caddy:2.11.9
