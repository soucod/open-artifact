{
  "name": "@open-artifact/server-sdk",
  "version": "0.14.6",
  "private": true,
  "type": "module",
  "description": "Shared code for Open Artifact type servers: the server skeleton, the Type API client, LAN sharing and a minimal WebSocket server.",
  "bin": {
    "open-artifact-frame-host": "bin/frame-host.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./serve": "./src/serve.ts",
    "./daemon": "./src/daemon.ts",
    "./lan": "./src/lan.ts",
    "./ws": "./src/ws.ts",
    "./frame": "./src/frame/index.ts",
    "./frame/imports": "./src/frame/page-imports.ts",
    "./frame/page-api": "./src/frame/page-api.ts",
    "./frame/core": "./src/frame/core.ts",
    "./frame/env": "./src/frame/env.ts",
    "./db": "./src/frame/db.ts",
    "./comments": "./src/frame/comments.ts",
    "./zip": "./src/zip.ts",
    "./type-package": "./src/type-package.ts",
    "./snapshot": "./src/snapshot.ts"
  },
  "dependencies": {
    "@open-artifact/protocol": "0.14.6"
  },
  "devDependencies": {
    "@open-artifact/editor-kit": "0.14.6",
    "@open-artifact/runtime": "0.14.6",
    "@open-artifact/ui": "0.14.6"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "Apache-2.0"
}
