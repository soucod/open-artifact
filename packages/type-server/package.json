    "@open-artifact/design-system-core": "0.14.6",
    "@open-artifact/slides-core": "0.14.6",
    "@open-artifact/whiteboard-core": "0.14.6",
    "@open-artifact/data-core": "0.14.6",
    "@open-artifact/docs-core": "0.14.6",
    "@open-artifact/sheets-core": "0.14.6",
    "@open-artifact/wasm-sheets": "0.14.6",
    "@open-artifact/motion-core": "0.14.6",
    "@open-artifact/motion-stage": "0.14.6",
    "acorn": "8.19.0",
    "pdfjs-dist": "6.4.299"
