{
  "name": "copilot",
  "title": "GitHub Copilot",
  "agentName": "Copilot",
  "level": "L2",
  "entry": "mcp",
  "plugin": "open-artifact",
  "mcp": {
    "command": "node",
    "args": [
      "${PLUGIN_ROOT}/skills/open-artifact/scripts/open-artifact.mjs",
      "mcp",
      "--harness",
      "copilot"
    ]
  },
  "skillsDir": "~/.copilot/skills",
  "wake": [
    "inbox"
  ],
  "open": "browser",
  "wakesIdle": false,
  "hookDialect": "copilot",
  "caps": {
    "tools": "mcp",
    "commands": {
      "names": [
        "open-artifact"
      ]
    }
  }
}
