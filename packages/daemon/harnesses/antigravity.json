{
  "name": "antigravity",
  "title": "Antigravity",
  "agentName": "Antigravity",
  "level": "L2",
  "entry": "mcp",
  "plugin": "open-artifact",
  "mcp": {
    "command": "node",
    "args": [
      "${PLUGIN_ROOT}/skills/open-artifact/scripts/open-artifact.mjs",
      "mcp",
      "--harness",
      "antigravity"
    ]
  },
  "sessionEnv": "ANTIGRAVITY_CONVERSATION_ID",
  "skillsDir": "~/.gemini/config/skills",
  "wake": [
    "inbox"
  ],
  "open": "browser",
  "markers": [
    "ANTIGRAVITY_AGENT",
    "ANTIGRAVITY_CONVERSATION_ID"
  ],
  "hookDialect": "antigravity",
  "nudge": {
    "command": [
      "${env:OPEN_ARTIFACT_ANTIGRAVITY_AGENTAPI}",
      "~/.gemini/antigravity/bin/agentapi",
      [
        "/Applications/Antigravity.app/Contents/Resources/bin/language_server",
        "agentapi"
      ]
    ],
    "args": [
      "send-message",
      "${session}",
      "${text}"
    ],
    "envFile": {
      "dir": "~/.gemini/antigravity/daemon",
      "pattern": "^hub_\\d+\\.json$",
      "pid": "pid"
    },
    "env": {
      "ANTIGRAVITY_LS_ADDRESS": "127.0.0.1:${file.httpPort}",
      "ANTIGRAVITY_CSRF_TOKEN": "${file.csrfToken}"
    }
  },
  "caps": {
    "tools": "mcp",
    "commands": {
      "names": [
        "open-artifact"
      ]
    }
  }
}
