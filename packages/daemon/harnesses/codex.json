{
  "name": "codex",
  "title": "Codex",
  "agentName": "Codex",
  "level": "L2",
  "entry": "mcp",
  "plugin": "open-artifact",
  "mcp": {
    "command": "node",
    "args": [
      "${PLUGIN_ROOT}/skills/open-artifact/scripts/open-artifact.mjs",
      "mcp",
      "--harness",
      "codex"
    ]
  },
  "sessionEnv": "CODEX_THREAD_ID",
  "skillsDir": "~/.agents/skills",
  "wake": [
    "inbox"
  ],
  "open": "browser",
  "markers": [
    "CODEX_THREAD_ID"
  ],
  "hookDialect": "claude-code",
  "sessionWorkspace": "codex-rollout",
  "nudge": {
    "command": [
      "${env:OPEN_ARTIFACT_CODEX_BIN}",
      "/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
      "codex"
    ],
    "args": [
      "queue",
      "--thread",
      "${session}",
      "--message",
      "${text}"
    ]
  },
  "caps": {
    "tools": "mcp",
    "commands": {
      "names": [
        "open-artifact"
      ]
    }
  }
}
